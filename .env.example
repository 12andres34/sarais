# Copia este archivo a .env y cambia TODOS los valores. .env nunca va a Git.
# Genera contraseñas alfanuméricas con:  openssl rand -hex 24
# (sin comillas ni símbolos: se usan dentro de SQL y de URIs)

# --- Solo en la VM: ignora docker-compose.override.yaml ---
# COMPOSE_FILE=docker-compose.yaml

TZ=America/Bogota

# --- MySQL ---
MYSQL_ROOT_PASSWORD=cambia_esto
MYSQL_DATABASE=sarais
MYSQL_APP_USER=sarais_app
MYSQL_APP_PASSWORD=cambia_esto
MYSQL_BACKUP_USER=sarais_backup
MYSQL_BACKUP_PASSWORD=cambia_esto

# --- MongoDB ---
MONGO_INITDB_ROOT_USERNAME=mongo_root
MONGO_INITDB_ROOT_PASSWORD=cambia_esto
MONGO_INITDB_DATABASE=sarais
MONGO_APP_USER=sarais_app
MONGO_APP_PASSWORD=cambia_esto

# --- App ---
APP_SECRET_KEY=cambia_esto
APP_TOTP_ENC_KEY=cambia_esto
DOCS_GPG_RECIPIENT=sarais-docs@example.local

# --- Backups (scripts/backup.sh) ---
BACKUP_DIR=/var/backups/sarais
BACKUP_RETENTION_DAYS=7
BACKUP_GPG_RECIPIENT=sarais-backup@example.local
# Copia externa (opcional, deja vacío para desactivar):
# a) carpeta montada (USB / carpeta compartida de VirtualBox)
BACKUP_EXTERNAL_DIR=
# b) otro servidor por SSH, formato usuario@host:/ruta
BACKUP_REMOTE=

# --- Logs y monitoreo ---
LOG_DIR=/var/log/sarais
METRICS_DIR=/var/log/sarais/metrics
ALERT_CPU=85
ALERT_RAM=85
ALERT_DISK=85
LOG_RETENTION_DAYS=30
METRICS_RETENTION_DAYS=90

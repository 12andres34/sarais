# Parámetros comunes del proxy hacia la app
proxy_pass http://sarais_app;
proxy_http_version 1.1;
proxy_set_header Host              $host;
proxy_set_header X-Real-IP         $remote_addr;
# $remote_addr REEMPLAZA lo que envíe el cliente: nadie puede falsificar su IP en la auditoría
# (uvicorn confía en esta cabecera porque corre con --forwarded-allow-ips "*")
proxy_set_header X-Forwarded-For   $remote_addr;
proxy_set_header X-Forwarded-Proto https;
proxy_read_timeout 60s;
# Si la app algún día envía estas cabeceras, se ocultan: las pone Nginx una sola vez
proxy_hide_header Strict-Transport-Security;
proxy_hide_header Permissions-Policy;
proxy_hide_header Cross-Origin-Opener-Policy;
